# Copy to backend/.env.local (git-ignored); scripts/dev-backend.sh loads it.
# Signing keys: run scripts/gen-dev-keys.sh to append AUTH_PRIVATE_KEY / AUTH_PUBLIC_KEY.

DB_URL=jdbc:postgresql://localhost:5432/pios
DB_USER=pios
DB_PASSWORD=pios

# Provider keys (only needed for the matching profile)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_CHAT_MODEL=gpt-5-mini
# ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5

# Must match the embedding model and is fixed once the database is migrated (ADR 0003).
EMBEDDING_DIMENSIONS=1536

# Storage: filesystem (default) or s3
STORAGE_TYPE=filesystem
STORAGE_ROOT=./data/storage
# S3_BUCKET=pios-documents
# S3_REGION=ap-south-1
